#!/usr/bin/env zsh

# Farben für die Ausgabe
YELLOW='\033[1;33m'
NC='\033[0m'

# Backup-Konfiguration
export ZSTD_CLEVEL=9
export ZSTD_NBTHREADS=2
backupDate=$(date '+%d%m%y')

# Docker-Container stoppen
for dir in docker/*
do
    pushd ${dir}
    docker-compose down
    popd
done

sleep 15

# Backup erstellen
pushd "$HOME"
sudo tar --create --sparse --zstd --file docker-backup-$backupDate.tar.zst --checkpoint=.100 --directory "$HOME" docker
popd

sleep 15

# Docker-Container wieder starten
for dir in docker/*
do
    pushd ${dir}
    docker-compose up -d
    popd
done

# Nur die drei neuesten Backups behalten
backup_dir="$HOME"

typeset -a backups
backups=()

for f in "$backup_dir"/docker-backup-*.tar.zst(N); do
    [[ -f "$f" ]] || continue
    base="${f:t}"
    datepart="${base#docker-backup-}"
    datepart="${datepart%.tar.zst}"
    dd="${datepart[1,2]}"
    mm="${datepart[3,4]}"
    yy="${datepart[5,6]}"
    backups+=("${yyyy}${mm}${dd} $f")
done

backups=(${(f)"$(print -l "${backups[@]}" | sort -r | awk '{print $2}')"})

if (( ${#backups[@]} > 3 )); then
    for file in "${backups[@]:3}"; do
        echo "Lösche altes Backup: $file"
        rm -f -- "$file"
    done
else
    echo "Nur ${#backups[@]} Backup(s) vorhanden – nichts zu löschen."
fi

print "${YELLOW}Backup abgeschlossen.${NC}"
